# Oppam Matrimony — environment template (PRD §15). Copy to .env and fill in.
# NEVER commit real secrets. Local dev values are noted where they differ from production.

APP_NAME="Oppam Matrimony"
APP_ENV=local                         # local | testing | staging | production
APP_KEY=
APP_DEBUG=true                        # false in staging/production
APP_TIMEZONE=UTC                      # always UTC; display timezone below
APP_DISPLAY_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000         # production: https://oppam.in
APP_DOMAIN=localhost                  # production: oppam.in
ADMIN_DOMAIN=admin.localhost          # production: admin.oppam.in
APP_INDEXABLE=false                   # true only at launch (replaces template SITE_LIVE)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                       # warning in production

# Database — local: XAMPP MariaDB (DB_CONNECTION=mariadb). Production: MySQL 8 (DB_CONNECTION=mysql).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oppam
DB_USERNAME=root
DB_PASSWORD=

# Drivers — local Windows has no Redis: use database. Production: redis for all three.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local                 # production: s3

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcasting — reverb (self-hosted) or pusher (managed). Switching needs no code change.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=oppam-local
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST=localhost                 # production: ws.oppam.in
REVERB_PORT=8080                      # production: 443
REVERB_SCHEME=http                    # production: https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false          # production: true (Redis pub/sub)

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2                # Mumbai

VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_DRIVER="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Dashboards live on the admin domain only
HORIZON_DOMAIN="${ADMIN_DOMAIN}"
PULSE_DOMAIN="${ADMIN_DOMAIN}"

MAIL_MAILER=log                       # production: ses
MAIL_FROM_ADDRESS="no-reply@oppam.test"
MAIL_FROM_NAME="${APP_NAME}"

# SMS / OTP — India DLT-registered templates
SMS_DRIVER=log                        # production: msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=OPPAMM
MSG91_OTP_TEMPLATE_ID=
MSG91_ACCOUNT_EXISTS_TEMPLATE_ID=       # DLT template for the "you already have an account" SMS

# Payments — Razorpay (test keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage — two buckets: public (approved photos via CDN) and private (ID docs, PAN, imports)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET_PUBLIC=
AWS_BUCKET_PRIVATE=
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=

# ── Admin panel (PRD §8.1, A01) ──
# Comma-separated IPs/CIDRs allowed to reach admin.*; empty = no restriction.
ADMIN_IP_ALLOWLIST=
ADMIN_IDLE_TIMEOUT=30
ADMIN_ABSOLUTE_TIMEOUT=720
# LOCAL ONLY: password for the demo admins (admin@oppam.test, moderator@oppam.test, …) created
# by `php artisan migrate:fresh --seed`. Choose your own; never set it anywhere but local.
ADMIN_SEED_PASSWORD=
